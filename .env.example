# Copy to .env (gitignored). docker compose reads it for the ${...} values in docker-compose.yml.

# Notes and visit summaries into facts and cards (backend/gemini.py). Without it, notes are stored
# as typed and visits are not summarized.
GEMINI_API_KEY=

# Nova, the voice assistant. Leave empty to run without her.
ANTHROPIC_API_KEY=

# Browser origins allowed to call the API: the UI's URL(s), comma-separated, or * for any.
NAMETAGS_CORS_ORIGINS=*

# Host port the API listens on.
NAMETAGS_PORT=8000
