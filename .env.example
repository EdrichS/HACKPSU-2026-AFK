# Copy to .env (gitignored). docker compose reads it for the ${...} values in docker-compose.yml.

# Notes and visit summaries into facts and cards (backend/gemini.py). Without it, the wizard and
# python -m enroll store notes as typed, POST /people/{id}/notes and /conversation store nothing,
# and visits are not summarized.
GEMINI_API_KEY=
# The Gemini model for that (default: the newest Flash, in backend/gemini.py). When Google answers
# 503 "high demand" on it, an older Flash such as gemini-3.6-flash is the quick fix.
GEMINI_MODEL=

# Nova, the voice assistant. Leave empty to run without her.
ANTHROPIC_API_KEY=

# Live captions word by word (Speechmatics real-time). The /live audio is streamed to the service
# while this is set. Leave empty for captions from the local model, one finished sentence at a time.
SPEECHMATICS_API_KEY=
# local: keep captions on this machine even when a key is set.
NAMETAGS_CAPTIONS=

# The API has no login, so by default only this machine can reach it.
# Address it listens on: 127.0.0.1 is this machine only (a TLS proxy here still reaches it);
# 0.0.0.0 opens it to every network the machine is on.
NAMETAGS_BIND=127.0.0.1

# Browser origins allowed to call the API: a UI on another site, comma-separated URLs.
# Empty allows pages on localhost or 127.0.0.1 only; * lets any website read everything it holds.
# This never covers the /live socket or form uploads: any page in a browser that can reach the API
# can open /live and send uploads.
NAMETAGS_CORS_ORIGINS=

# Host port the API listens on.
NAMETAGS_PORT=8000
