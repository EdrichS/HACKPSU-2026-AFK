# Copy to .env (gitignored). docker compose reads it for the ${...} values in docker-compose.yml.

# Visit summaries and Nova. Leave empty to run without them.
ANTHROPIC_API_KEY=

# Browser origins allowed to call the API: the UI's URL(s), comma-separated, or * for any.
NAMETAGS_CORS_ORIGINS=*

# Host port the API listens on.
NAMETAGS_PORT=8000
