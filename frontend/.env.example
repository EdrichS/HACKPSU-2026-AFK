# Copy to .env.local and edit. Values starting with VITE_ are built into the pages.

# Where Vite forwards /api: the mock (uv run uvicorn mock.app:app --port 8000) or the real backend.
NAMETAGS_API=http://127.0.0.1:8000

# The glasses user's first name for the visitor copy ("Help Rose remember you.") when the API has
# no registered user yet. A ?for=Name link, the user registered on the API (GET /user), or a setup
# done in the same browser all take precedence.
VITE_GLASSES_USER_NAME=Rose

# Shown on the Consent screen. Left empty, the screen shows the [contact email] placeholder.
VITE_CONTACT_EMAIL=

# The voice the glasses speak with: voice names, best first, comma-separated; the first one installed
# on the device wins (macOS: System Settings > Accessibility > Spoken Content > System voice > Manage
# voices; "Enhanced"/"Premium" downloads sound much better and match the same name). Empty: Daniel, then Samantha.
VITE_VOICE=
