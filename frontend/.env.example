# Copy to .env.local and edit. Values starting with VITE_ are built into the pages.

# Where Vite forwards /api: the mock (uv run uvicorn mock.app:app --port 8000) or the real backend.
NAMETAGS_API=http://127.0.0.1:8000

# The glasses user's first name, used across the visitor copy ("Help Rose remember you.").
# A ?for=Name link, or the glasses-user setup done in the same browser, overrides it.
VITE_GLASSES_USER_NAME=Rose

# Shown on the Consent screen. Left empty, the screen shows the [contact email] placeholder.
VITE_CONTACT_EMAIL=
